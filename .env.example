# Copy this file to .env and fill in your values
# NEVER commit .env to git

PORT=3002

# Your live site's origin - locks down CORS so only your site can call this API
ALLOWED_ORIGIN=https://rjinnovatech.co.za

# Used to build the successUrl/cancelUrl/failureUrl sent to Yoco. Should match
# ALLOWED_ORIGIN without a trailing slash.
SITE_URL=https://rjinnovatech.co.za

# ============================================================
# YOCO
# From your Yoco Business Portal -> Online Payments -> API Keys
# ============================================================
# Secret key - starts with sk_live_... (or sk_test_... while testing)
YOCO_SECRET_KEY=

# Webhook signing secret - starts with whsec_...
# Set this after you register the webhook URL in the Yoco dashboard:
#   https://<this-server>/api/yoco/webhooks
YOCO_WEBHOOK_SECRET=

# ============================================================
# ORDER NOTIFICATIONS (optional)
# Free WhatsApp alert via CallMeBot when a payment succeeds.
# Leave blank to skip - orders are always logged and visible at /orders regardless.
# Format: phone:apikey (international, no '+')
# ============================================================
NOTIFY_WHATSAPP=

# ============================================================
# ORDER NOTIFICATIONS - EMAIL (optional)
# Sends an email via your own mail server (e.g. Afrihost) the moment an order
# is paid. Leave any of these blank to skip - orders are always logged and
# visible at /orders regardless.
# Afrihost's standard settings: host mail.<yourdomain>, port 465 (SSL) or
# 587 (STARTTLS), username = full mailbox address.
# ============================================================
SMTP_HOST=mail.rjinnovatech.co.za
SMTP_PORT=465
SMTP_USER=Sales@rjinnovatech.co.za
SMTP_PASS=
# Who receives the notification - defaults to SMTP_USER if left blank.
NOTIFY_EMAIL=Sales@rjinnovatech.co.za

# ============================================================
# /orders DASHBOARD LOGIN (required)
# The dashboard shows customer names, emails, phone numbers and orders - it is
# LOCKED (returns 503, not open) if these are left blank. Pick a real password,
# not a placeholder - this protects real customer PII once orders start coming in.
# Sent as HTTP Basic Auth, so only ever access /orders over https://.
# ============================================================
ORDERS_USER=
ORDERS_PASS=
